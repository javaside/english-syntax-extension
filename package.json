{
  "name": "english-syntax-extension",
  "version": "1.1.0",
  "private": true,
  "description": "Chrome MV3 扩展：把网页英文段落替换为逐句句法拆解卡片，由任意 OpenAI 兼容模型驱动。",
  "license": "MIT",
  "author": "Xinghua Zhou",
  "homepage": "https://github.com/javaside/english-syntax-extension#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javaside/english-syntax-extension.git"
  },
  "bugs": {
    "url": "https://github.com/javaside/english-syntax-extension/issues"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "english",
    "syntax",
    "llm",
    "ollama"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "package": "npm run build && node scripts/package-extension.mjs",
    "release": "node scripts/release.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "promo": "node scripts/generate-promo.mjs",
    "screenshots": "STORE_SHOTS=1 playwright test screenshots",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:baseline": "node scripts/check-lint-baseline.mjs",
    "docs:drift": "node scripts/check-docs-drift.mjs",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/chrome": "0.2.6",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.11.6",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vite-plugin-web-extension": "4.5.1",
    "vitest": "4.1.11"
  }
}
