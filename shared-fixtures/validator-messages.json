{
  "schemaVersion": 1,
  "coveredMessageSubstrings": [
    "adjacent PREDICATE components must be merged",
    "a PREDICATE must begin with the verb group",
    "a PREDICATE must cover only the verb group",
    "a clause introduced by a subordinating conjunction is not a COORDINATE_CLAUSE",
    "a preposition must be merged with the phrase it governs",
    "CONJUNCTION must cover a coordinating conjunction",
    "a clause component must cover a whole clause",
    "a component that starts with a subordinating conjunction",
    "a SUBJECT_CLAUSE must start with a subject-clause introducer",
    "an ATTRIBUTIVE_CLAUSE keeps its whole internal structure",
    "a component must not end on a preposition",
    "one component must not cover the whole sentence",
    "a whole-sentence fragment component must not exceed 10 lexical tokens",
    "must contain a non-punctuation component",
    "COORDINATE_CLAUSE is deprecated",
    "a non-clausal fragment must contain at most one FRAGMENT_HEAD",
    "FRAGMENT_HEAD marks a non-clausal fragment",
    "translation must include a meaningful Chinese gloss"
  ],
